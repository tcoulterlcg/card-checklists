{
  "buildCommand": "npm run build",
  "ignoreCommand": "P=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git cat-file -e $P 2>/dev/null || exit 1; git diff --quiet \"$P\" HEAD -- . ':(exclude)scripts/data/tcdb-hole-jobs.json' ':(exclude)scripts/data/catalog-hole-hints.json' ':(exclude)*.md' ':(exclude)scripts/sql'",
  "git": {
    "deploymentEnabled": {
      "catalog": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
